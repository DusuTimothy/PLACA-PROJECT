# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
# Public CA bundles contain no private key and are needed by hosted deploys
# (Render, Aiven). Keep the Aiven CA available to DB_SSL_CA.
!server/src/certs/aiven-ca.pem

# Build output
client/dist/
server/uploads/*
!server/uploads/.gitkeep

# Logs and local data
logs/
*.log
.DS_Store

# Test output
coverage/
server/coverage/
client/coverage/
