# PLACA Platform environment variables
#
# Copy this file to .env before starting Docker Compose:
#   cp .env.example .env
#
# Every secret below must be replaced with a long random value in production.
# The server refuses to start in production while a value still begins with
# "dev-".

# ---------- Runtime ----------
NODE_ENV=development
PORT=5000
# Host ports used by docker-compose.yml
SERVER_PORT=5000
CLIENT_PORT=5173
NGINX_PORT=80

# ---------- Database ----------
# Inside Docker the host is the compose service name. When running the API
# directly on your machine, set DB_HOST=localhost and DB_PORT to the published
# PostgreSQL port.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=placa
DB_USER=placa
DB_PASSWORD=placa_password
# Set to true only while debugging SQL; it prints every statement.
DB_LOGGING=false

# ---------- Database TLS (Aiven and other managed PostgreSQL) ----------
# The local Compose database does not use TLS, so keep DB_SSL=false there.
# Aiven requires TLS. Download ca.pem from the Aiven service page, put it in
# server/src/certs/ (the server folder is mounted into the Compose container
# at /app), then set:
#   DB_SSL_MODE=require
#   DB_SSL_CA=src/certs/aiven-ca.pem
#   DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA may be a file path (relative to the working directory, the
# repository root or server/) or the PEM text itself. *.pem files are ignored
# by git, so a certificate can also be pasted into the .env file.
# DB_SSL_MODE is an alternative to DB_SSL using libpq names: disable, require,
# verify-ca or verify-full. "require" encrypts without verifying the chain;
# the other verifying modes also check the hostname.
DB_SSL=false
DB_SSL_MODE=require
DB_SSL_CA=src/certs/aiven-ca.pem
DB_SSL_REJECT_UNAUTHORIZED=true

# ---------- URLs and CORS ----------
CLIENT_URL=http://localhost:5173
# The signed-in app lives under this path. "/" is the public landing page.
APP_BASE_PATH=/app
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional public address of the landing page, used only at client build time.
# Leave blank until a domain is assigned: canonical links stay relative and no
# sitemap.xml is generated. Set it to e.g. https://placa.example.gov.ng to make
# canonical/hreflang URLs absolute and generate sitemap.xml.
# When running the client outside Docker, put the same value in client/.env
# (Vite reads that file rather than this one).
SITE_URL=

# ---------- Authentication ----------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-access-secret-change-me-before-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-before-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
BCRYPT_ROUNDS=12

# Per-account lockout after repeated wrong passwords.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ---------- Public results (aggregation) ----------
# An LGA-level figure below this many people is never published, so a tiny
# count cannot identify a person. State totals are always published.
PUBLIC_SMALL_CELL_THRESHOLD=5
# Off by default. In production set true so validated reports reach the public
# page without anyone remembering to run `npm run aggregate`.
ENABLE_AGGREGATION_CRON=false
# Five-field cron expression, server time. Default is 02:30 every day.
AGGREGATION_CRON=30 2 * * *

# ---------- Two-step verification (director/admin) ----------
# Key used by pgcrypto to encrypt users.totp_secret inside PostgreSQL.
# Generate with: openssl rand -base64 32
# Changing this value makes existing TOTP secrets unreadable; affected users
# must set up their authenticator again.
TOTP_ENCRYPTION_KEY=dev-totp-key-change-me-before-production
TOTP_ISSUER=PLACA Platform

# ---------- Email (Brevo, optional) ----------
# Leave empty to skip email. Invitation links and temporary passwords are still
# returned to the creating staff member so they can hand them over in person.
BREVO_API_KEY=
EMAIL_FROM=noreply@placa.org.ng
EMAIL_FROM_NAME=PLACA Platform

# ---------- AI assistant (Gemini, optional) ----------
# Server-only key. It is never sent to the browser. Get a key from Google AI
# Studio (https://aistudio.google.com/app/apikey) and restart the server after
# setting it. Leave blank to keep the assistant disabled with a clear message.
GEMINI_API_KEY=
# Model and endpoint may be pinned if the provider changes a default.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_MS=30000
# Prior conversation turns sent with each question. The full conversation is
# still stored in PostgreSQL for the user to continue later.
AI_MAX_HISTORY_MESSAGES=12
# Per-account limit for model calls, separate from the global IP limit.
AI_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX=30
# Anonymous landing-page chat is stateless and keyed by IP. Keep this smaller.
PUBLIC_AI_RATE_LIMIT_WINDOW_MS=600000
PUBLIC_AI_RATE_LIMIT_MAX=8

# ---------- File storage (used from Phase 2 onwards) ----------
STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# ---------- Rate limiting ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=100
